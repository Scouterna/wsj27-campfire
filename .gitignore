# Dependencies
node_modules/

# pnpm's store, if an install ever writes it beside the project.
.pnpm-store/

# Build output
.build/

# Native build artifacts
.gradle/
.kotlin/
*.hprof
**/DerivedData/
**/.swiftpm/

# Gradle writes its problems report under the build root's default build/ dir,
# which the .build redirect in apps/android/build.gradle.kts does not cover, even
# though every project in that build honors the redirect.
apps/android/build/

# IDE project files and the local SDK pointer Android Studio writes
.idea/
apps/android/local.properties

# Xcode writes per-user state inside the project bundle, and IDEWorkspaceChecks
# records one machine's answer to a one-time Xcode prompt.
apps/apple/**/xcuserdata/
apps/apple/**/xcshareddata/IDEWorkspaceChecks.plist

# sourcekit-lsp reads buildServer.json to resolve Xcode-built modules in editors
# like Zed. It is generated by xcode-build-server and holds absolute, per-machine
# DerivedData paths, so it is per-developer and not committed.
buildServer.json

# The dev and prod environments' secrets: the env and the secret file hold a Keycloak
# client secret, and the key signs local sessions. The fake-user file is written and
# removed by `pnpm start:dev --user-id`, and is per-run rather than anyone's to commit.
config/environments/*/.env
config/environments/*/fake-user.env
config/environments/*/signing-key.pem

# Structurizr's local server writes a search index, logs, and thumbnails here.
docs/architecture/.structurizr/

# OS files
.DS_Store

# Agents
.agents/specs/

# Scratch space for reference material under study – never committed.
temp/

# The units' names and artwork stay off the public repository until the reveal.
# Commit the folder, and drop these lines, the day the curtain opens.
apps/web/assets/units/

# The CMT roster the project API mints detail roles from – real people's member
# numbers and names, so it stays off the public repository. Get the file from the
# back-end team and put it in the dev environment; prod reaches it through the
# committed symlink beside its compose file. Without it CMT members keep the
# plain role.
config/environments/dev/cmt-roles.csv
