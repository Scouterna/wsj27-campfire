<resources>
  <style name="Theme.Campfire" parent="android:Theme.Material.Light.NoActionBar">
    <!-- The window the system shows while the process starts, in the icon's tonal
         blue, so on Android 12 and newer the splash screen's icon sits on its own
         background color and on Android 11 the window is plain blue. -->
