<?xml version="1.0" encoding="utf-8" ?>
<!--
  The development server speaks cleartext, which Android refuses by default, so it is
  permitted for the loopback address and the emulator's alias for the host machine and
  nothing else.
-->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">localhost</domain>
    <domain includeSubdomains="true">10.0.2.2</domain>
  </domain-config>
</network-security-config>
