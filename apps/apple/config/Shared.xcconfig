// Settings every configuration shares.
//
// The shell's version lives in its own git tag rather than the tree, and the build never
// reads git, so a release passes CAMPFIRE_VERSION_NUMBER and CAMPFIRE_BUILD_NUMBER to
// xcodebuild and any other build is 0.0.0 build 1.
CAMPFIRE_VERSION_NUMBER = 0.0.0
CAMPFIRE_BUILD_NUMBER = 1

// One identity across every environment, so installing one replaces another – the
// accepted cost of not maintaining an identity per environment for a difference that is
// one URL.
CAMPFIRE_BUNDLE_ID = se.scouterna.campfire
CAMPFIRE_APP_NAME = Campfire

// The team that signs the app, so it can run on a real device.
CAMPFIRE_DEVELOPMENT_TEAM = TYDB2KZGTZ
