# Editor defaults, for the editor rather than for Prettier. Wherever Prettier
# formats a file these values already match it, so the two cannot disagree; what
# they add is an editor that gets it right while typing, and a rule for the files
# Prettier leaves alone – the git hooks and shell scripts, the Caddyfiles, the
# Structurizr DSL, the xcconfigs, and the Swift and Kotlin sources.
#
# It sits at the root rather than under config/ (ADR 006), because .editorconfig
# is found by walking up from the file being edited and `root = true` ends that
# walk. ktlint's Gradle plugin reads its rules by the same walk, which is why the
# Kotlin section is rules rather than editor defaults.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[{Caddyfile,*.Caddyfile}]
# Caddy's own formatter indents with tabs, and Prettier has no parser for these.
indent_style = tab

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 100
# Compose composables are PascalCase functions by convention, and the rule that
# forbids that cannot tell one from an ordinary function.
ktlint_function_naming_ignore_when_annotated_with = Composable, Test
