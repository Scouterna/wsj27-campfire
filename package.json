{
  "name": "@scouterna/wsj27-campfire",
  "version": "0.0.0",
  "private": true,
  "description": "Digital home for the leaders and contingent management team of Scouterna's Swedish contingent to WSJ27 in Poland.",
  "homepage": "https://scouterna.github.io/wsj27-campfire",
  "repository": "github:Scouterna/wsj27-campfire",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:android:dev": "apps/android/gradlew -p apps/android assembleDevDebug",
    "build:android:prod": "apps/android/gradlew -p apps/android assembleProdDebug",
    "build:apple:dev": "sh scripts/apple/build.sh dev",
    "build:apple:prod": "sh scripts/apple/build.sh prod",
    "build:arch": "node scripts/structurizr/run.ts export",
    "build:guidebook": "vitepress build docs",
    "build:image": "docker build --platform linux/amd64 --file config/environments/prod/Dockerfile --tag wsj27-campfire .",
    "build:storybook": "storybook build -o .build/storybook --config-dir config/storybook",
    "build:web": "pnpm --filter @scouterna/wsj27-campfire-web build",
    "check:android:format": "apps/android/gradlew -p apps/android ktlintCheck",
    "check:android:lint": "apps/android/gradlew -p apps/android detekt lintLocalDebug",
    "check:apple:format": "swiftformat --config config/swiftformat/.swiftformat --lint apps/apple",
    "check:apple:lint": "swiftlint lint --config config/swiftlint/.swiftlint.yml --strict apps/apple/src apps/apple/test apps/apple/test-ui",
    "check:arch": "node scripts/structurizr/run.ts check",
    "check:format": "prettier --config config/prettier/prettier.config.ts --ignore-path config/prettier/prettier.ignore --check .",
    "check:lint": "eslint --max-warnings 0 .",
    "check:markdown": "markdownlint-cli2 --config config/markdownlint/markdownlint-cli2.jsonc",
    "check:types": "tsc --noEmit",
    "clean": "rm -rf .build apps/*/.build apps/android/build apps/android/.gradle apps/android/.kotlin && pnpm --recursive --if-present run clean",
    "format": "prettier --config config/prettier/prettier.config.ts --ignore-path config/prettier/prettier.ignore --write .",
    "format:android": "apps/android/gradlew -p apps/android ktlintFormat",
    "format:apple": "swiftformat --config config/swiftformat/.swiftformat apps/apple",
    "format:svg": "svgo apps/*/assets/*.svg apps/*/assets/units/*.svg config/*/assets/*.svg libraries/*/assets/images/*.svg",
    "generate:apple": "xcodegen generate --spec apps/apple/project.yml --project apps/apple",
    "ide:android": "open -a 'Android Studio' apps/android",
    "ide:apple": "open apps/apple/Campfire.xcodeproj",
    "prepare": "git config core.hooksPath .githooks || true",
    "start:android": "sh scripts/android/start.sh",
    "start:apple": "sh scripts/apple/start.sh",
    "start:arch": "node scripts/structurizr/run.ts layout",
    "start:dev": "sh scripts/start/dev.sh",
    "start:guidebook": "sh scripts/start/server.sh guidebook 3001 vitepress dev docs",
    "start:local": "sh scripts/start/local.sh",
    "start:mock": "sh scripts/start/server.sh mock 8003 pnpm --filter @scouterna/wsj27-campfire-mock start",
    "start:prod": "sh scripts/start/prod.sh",
    "start:storybook": "sh scripts/start/server.sh storybook 3002 storybook dev -p 3002 --exact-port --no-open --config-dir config/storybook",
    "start:web": "sh scripts/start/server.sh web 3000 pnpm --filter @scouterna/wsj27-campfire-web start",
    "test": "vitest run --config config/vitest/vitest.config.ts --coverage",
    "test:android": "apps/android/gradlew -p apps/android testLocalDebugUnitTest assembleLocalDebugAndroidTest",
    "test:android:ui": "serial=$(sh scripts/android/emulator.sh) && ANDROID_SERIAL=\"$serial\" apps/android/gradlew -p apps/android connectedLocalDebugAndroidTest",
    "test:apple": "sh scripts/apple/test.sh CampfireTests",
    "test:apple:ui": "sh scripts/apple/test.sh CampfireUITests",
    "test:web:ui": "playwright test --config config/playwright/playwright.config.ts",
    "version:next": "node scripts/release/next-version.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/types": "21.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@prettier/plugin-xml": "3.4.2",
    "@storybook/addon-docs": "10.5.9",
    "@storybook/react-vite": "10.5.9",
    "@types/node": "24.13.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "64.1.0",
    "eslint-plugin-jsonc": "3.4.1",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-no-secrets": "2.3.3",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.1.1",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unicorn": "73.0.0",
    "globals": "17.10.0",
    "jiti": "2.7.0",
    "markdownlint-cli2": "0.23.2",
    "mermaid": "11.16.1",
    "prettier": "3.9.6",
    "prettier-plugin-curly": "0.4.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.5.9",
    "svgo": "4.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vitest": "4.1.11",
    "vue": "3.5.41",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24"
  }
}
