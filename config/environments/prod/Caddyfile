# The prod environment: the deployable image itself, serving a production build behind
# the same front door, so what runs here is the artifact that would be deployed rather
# than a dev server pretending to be one. The back-end is whatever containers are up.
#
# The front doors all serve http://localhost:8000, so the web application and
# the shells never know which environment is running.
#
# One Caddy config per way Campfire is served, one folder per environment:
#   local/Caddyfile       `pnpm start:local`, the mock back-end
#   dev/Caddyfile         `pnpm start:dev`, the real back-end in containers
#   prod/Caddyfile        this one – `pnpm start:prod`, the built image against the real back-end
#   prod/image.Caddyfile  inside the image, wherever it is deployed
:8000 {
	# The web waits for the back-end. A session signed in before the auth service has its
	# roles carries none, and reads as a participant's until its token is next refreshed,
	# so until the auth service's health check says its roles are loaded the page answers
	# 503 and nobody can start a sign-in. The roles arrive only from the project API,
	# which answers only once its database and Scoutnet are read, so this one check waits
	# for every service.
	handle_errors 503 {
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><meta http-equiv="refresh" content="3"><title>Campfire is starting</title><p>Campfire is starting – the back-end services are not ready yet. This page reloads itself.</p>` 503
	}

	# The prefix is stripped before proxying, because the real service serves its endpoints
	# at its root, and the deployed ingress strips it too. The matcher names the bare prefix
	# beside the subtree, because the ingress answers both – so `/api/auth` reaches the
	# service's health check rather than falling through to the web application.
	@auth path /api/auth /api/auth/*
	handle @auth {
		uri strip_prefix /api/auth
		reverse_proxy auth:8000
	}

	# The same for the project API, which serves its endpoints at its root too.
	# localhost, because the service shares the ingress's network namespace –
	# compose.yaml says why.
	@project path /api/project /api/project/*
	handle @project {
		uri strip_prefix /api/project
		reverse_proxy localhost:8001
	}

	# The image runs its own Caddy on 8080 (prod/image.Caddyfile), which is what
	# serves the built files and falls back to index.html for a deep link.
	handle {
		reverse_proxy web:8080 {
			health_upstream auth:8000
			health_uri /
			health_body `"stale":false`
			health_interval 2s
		}
	}
}
