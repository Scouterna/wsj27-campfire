// The rules, layered on markdownlint's defaults. `default: true` keeps every rule
// this file does not name switched on, so one added in a future release arrives
// enabled rather than silently absent.
//
// What each override is for is written once, in the Markdownlint section of
// .agents/skills/writing-markdown/references/tooling-guide.md, so there is one copy
// to keep true.
{
  "default": true,
  "MD003": { "style": "atx" },
  "MD004": { "style": "dash" },
  "MD007": { "indent": 2 },
  "MD013": false,
  "MD024": { "siblings_only": true },
  "MD025": { "front_matter_title": "" },
  "MD029": { "style": "ordered" },
  "MD033": { "allowed_elements": ["Badge", "p", "br"] },
}
