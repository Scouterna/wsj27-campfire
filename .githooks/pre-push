#!/bin/sh
# The repository checks, run before the work leaves the machine. A commit is often
# unfinished, and a push is where somebody else could see it.
#
# The shared checks and the TypeScript tests always run, because they need only Node
# and pnpm. Each shell's checks and tests run only where its toolchain is usable,
# probed by running the tool, because macOS ships failing stubs at /usr/bin/java and
# /usr/bin/xcodebuild that `command -v` would treat as present. A missing toolchain
# skips its platform loudly and still pushes, since the web application needs
# neither and not everyone has a Mac.
#
# The hook stops at the first failure, so the finding stays on screen instead of
# scrolling away behind the checks that follow.

set -e

# True when the named tool actually runs to completion.
usable() {
  "$@" >/dev/null 2>&1
}

# Names a skipped platform and the toolchain it needed, because a check nobody knows
# was skipped is worse than one that did not run.
skip() {
  echo
  echo "Skipping $1: $2 is not available here."
}

for check in check:format check:lint check:markdown check:types; do
  pnpm "$check"
done

# A suite that runs only when someone remembers goes red unnoticed.
pnpm test

# True when Gradle can locate an Android SDK, looked up the way Gradle does it –
# local.properties first, then ANDROID_HOME, then ANDROID_SDK_ROOT. The directory has
# to exist, because an sdk.dir naming a moved SDK is the same as none.
android_sdk() {
  sdk="$(sed -n 's/^sdk\.dir=//p' apps/android/local.properties 2>/dev/null | tail -n1)"
  [ -d "${sdk:=${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}}" ]
}

# Gradle's lint needs an Android SDK as well as a JDK. Gated on the JDK alone, a
# machine without an SDK would fail the push on Gradle's "SDK location not found"
# instead of skipping.
if usable java -version && android_sdk; then
  pnpm check:android:format
  pnpm check:android:lint
  pnpm test:android
else
  skip "the Kotlin checks and tests" "a complete Android toolchain (a JDK and an SDK)"
fi

# No continuous integration runs the Swift checks, so a skip here is the whole gap.
if usable swiftformat --version && usable swiftlint --version; then
  pnpm check:apple:format
  pnpm check:apple:lint
else
  skip "the Swift checks" "swiftformat or swiftlint"
fi

# The Swift tests need Xcode itself, so they are gated on it separately.
if usable xcodebuild -version; then
  pnpm test:apple
else
  skip "the Swift tests" "Xcode"
fi
