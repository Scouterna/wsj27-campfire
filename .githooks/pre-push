#!/bin/sh
# The repository checks, run before the work leaves the machine. Commits are
# frequent and often unfinished; a push is the point where somebody else could
# see it, so that is where the checks belong.
#
# The shared checks and the TypeScript tests always run – they need only Node and
# pnpm, which is what this repository is built on. Each platform's native checks
# and tests run only when that toolchain is usable, probed by running the tool
# rather than by a PATH lookup – macOS ships failing stubs at /usr/bin/java and
# /usr/bin/xcodebuild that a `command -v` check would wrongly treat as present. A
# machine missing a toolchain skips that platform loudly and still pushes; a real
# finding on a present toolchain blocks the push. Kotlin and Swift are optional
# because not everyone has a Mac and not everyone works on the shells – the web
# application needs neither.
#
# The checks run in sequence and the hook stops at the first failure, so the
# finding stays on screen instead of scrolling away behind the checks that
# follow, and a push is not held up waiting on every check to finish when the
# first one already says no.

set -e

# True when the named tool actually runs to completion.
usable() {
  "$@" >/dev/null 2>&1
}

# Names a skipped platform and the toolchain it needed: a check nobody knows was
# skipped is worse than one that did not run.
skip() {
  echo
  echo "Skipping $1: $2 is not available here."
}

# The shared toolchain. These need only Node.
for check in check:format check:lint check:markdown check:types; do
  pnpm "$check"
done

# The TypeScript tests, in the same breath as the checks: they need only Node too,
# and a suite that runs when someone remembers is a suite that goes red unnoticed.
pnpm test

# True when Gradle can locate an Android SDK, asked the way Gradle asks: sdk.dir
# in the gitignored apps/android/local.properties first, then ANDROID_HOME, then
# ANDROID_SDK_ROOT. The directory has to be there – a local.properties naming an
# SDK that was moved or never installed is the same as no SDK at all.
android_sdk() {
  sdk="$(sed -n 's/^sdk\.dir=//p' apps/android/local.properties 2>/dev/null | tail -n1)"
  [ -d "${sdk:=${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}}" ]
}

# Kotlin: ktlint checks the formatting, and Detekt and Gradle's lint check the
# code. Both need a JDK, and Gradle's lint needs an Android SDK – both, not just
# the JDK. A machine with a JDK and no SDK passes a java-only gate and then fails
# the push on Gradle's "SDK location not found", which is the obscure message
# this hook exists to turn into a skip.
if usable java -version && android_sdk; then
  pnpm check:android:format
  pnpm check:android:lint
  pnpm test:android
else
  skip "the Kotlin checks and tests" "a complete Android toolchain (a JDK and an SDK)"
fi

# Swift: SwiftFormat lints the formatting and SwiftLint checks the code, both
# self-contained binaries from Homebrew. There is no continuous integration
# behind them, so a skip here is the whole gap.
if usable swiftformat --version && usable swiftlint --version; then
  pnpm check:apple:format
  pnpm check:apple:lint
else
  skip "the Swift checks" "swiftformat or swiftlint"
fi

# The Swift tests need Xcode itself, so they are gated on it separately.
if usable xcodebuild -version; then
  pnpm test:apple
else
  skip "the Swift tests" "Xcode"
fi
